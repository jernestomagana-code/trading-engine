//@version=6
indicator("Stock Ultimus Options Underlying Alerts v1.1",overlay=true)
// Technical evidence only. Never authorizes or submits an order.
tz=input.string("America/New_York","Timezone")
rth=input.session("0930-1600","Regular session")
minAdx=input.float(18.0,"Minimum ADX")
minRvol=input.float(1.05,"Minimum RVOL")
vixHigh=input.float(22.0,"VIX elevated")
vixLow=input.float(18.0,"VIX normalized")
regular=not na(time(timeframe.period,rth,tz))
vwapValue=ta.vwap(hlc3)
emaFast=ta.ema(close,21)
emaSlow=ta.ema(close,50)
rsiValue=ta.rsi(close,14)
[plusDi,minusDi,adxValue]=ta.dmi(14,14)
atrValue=ta.atr(14)
averageVolume=ta.sma(volume,20)
rvolValue=averageVolume>0?volume/averageVolume:0.0
symbolCode=str.contains(syminfo.ticker,"VIX")?"VIX":str.contains(syminfo.ticker,"SPY")?"SPY":"QQQ"
timeframeCode=(timeframe.period=="D" or timeframe.period=="1D")?"D":timeframe.period+"M"
qualityOk=adxValue>=minAdx and rvolValue>=minRvol
longSignal=barstate.isconfirmed and regular and qualityOk and close>vwapValue and emaFast>emaSlow and rsiValue>=52
shortSignal=barstate.isconfirmed and regular and qualityOk and close<vwapValue and emaFast<emaSlow and rsiValue<=48
snapshotSignal=barstate.isconfirmed and regular and symbolCode!="VIX" and bar_index%3==0
vixElevated=barstate.isconfirmed and symbolCode=="VIX" and close>=vixHigh and close>emaFast
vixNormalized=barstate.isconfirmed and symbolCode=="VIX" and close<=vixLow and close<emaFast
num(value)=>na(value)?"0":str.tostring(value,format.mintick)
textPair(key,value)=>"\""+key+"\":\""+value+"\""
numPair(key,value)=>"\""+key+"\":"+num(value)
payload(eventName,eventCode,direction,signalName,volatilityState,stopPrice,targetPrice)=>
    "{"+textPair("source","TRADINGVIEW")+","+textPair("strategy_context","OPTIONS_UNDERLYING_CONFIRMATION")+","+textPair("event",eventName)+","+textPair("event_code",eventCode)+","+textPair("ticker",syminfo.ticker)+","+textPair("timeframe",timeframe.period)+","+textPair("breakout_direction",direction)+","+numPair("price",close)+","+numPair("logical_stop",stopPrice)+","+numPair("logical_target",targetPrice)+","+numPair("adx",adxValue)+","+numPair("atr",atrValue)+","+numPair("rsi",rsiValue)+","+numPair("volume_relative",rvolValue)+","+numPair("vwap",vwapValue)+","+textPair("underlying_signal",signalName)+","+textPair("volatility_state",volatilityState)+",\"action\":\"ALERT_ONLY\",\"execution_authorized\":false,\"not_order_instruction\":true}"
if longSignal
    alert(payload("TECH_CONFIRM",symbolCode+"_TECH_CONFIRM_LONG_"+timeframeCode,"LONG","TECH_CONFIRM_LONG","NORMAL",close-atrValue,close+2*atrValue),alert.freq_once_per_bar_close)
if shortSignal
    alert(payload("TECH_CONFIRM",symbolCode+"_TECH_CONFIRM_SHORT_"+timeframeCode,"SHORT","TECH_CONFIRM_SHORT","NORMAL",close+atrValue,close-2*atrValue),alert.freq_once_per_bar_close)
if snapshotSignal
    alert(payload("REGIME_SNAPSHOT",symbolCode+"_REGIME_SNAPSHOT_"+timeframeCode,"NONE","REGIME_SNAPSHOT","NORMAL",0,0),alert.freq_once_per_bar_close)
if vixElevated
    alert(payload("VOLATILITY_RISK","VIX_RISK_ELEVATED_"+timeframeCode,"BEARISH","VIX_RISK_ELEVATED","ELEVATED",0,0),alert.freq_once_per_bar_close)
if vixNormalized
    alert(payload("VOLATILITY_RISK","VIX_RISK_NORMALIZED_"+timeframeCode,"NEUTRAL","VIX_RISK_NORMALIZED","NORMALIZED",0,0),alert.freq_once_per_bar_close)
plot(vwapValue,"VWAP",color.blue,2)
plot(emaFast,"EMA fast",color.aqua)
plot(emaSlow,"EMA slow",color.purple)
plotshape(longSignal,"Long",shape.triangleup,location.belowbar,color.green,size=size.tiny)
plotshape(shortSignal,"Short",shape.triangledown,location.abovebar,color.red,size=size.tiny)
alertcondition(longSignal,"Underlying Tech Confirm Long","Stock Ultimus Underlying Tech Confirm Long")
alertcondition(shortSignal,"Underlying Tech Confirm Short","Stock Ultimus Underlying Tech Confirm Short")
alertcondition(snapshotSignal,"Underlying Regime Snapshot","Stock Ultimus Underlying Regime Snapshot")
alertcondition(vixElevated,"VIX Risk Elevated","Stock Ultimus VIX Risk Elevated")
alertcondition(vixNormalized,"VIX Risk Normalized","Stock Ultimus VIX Risk Normalized")
