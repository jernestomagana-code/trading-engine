//@version=6
indicator("Stock Ultimus Intraday Futures FAST v2", overlay=true)

tz = input.string("America/New_York", "Session timezone")
pmSession = input.session("0400-0929", "Premarket")
orSession = input.session("0930-0935", "Opening range")
rthSession = input.session("0930-1600", "Regular session")
minAdx = input.float(18.0, "Minimum 5m ADX", step=0.5)
minRvol = input.float(1.10, "Minimum 5m RVOL", step=0.05)
persistence = input.int(1, "Confirmed 1m closes", minval=1, maxval=2)

inPm = not na(time(timeframe.period, pmSession, tz))
inOr = not na(time(timeframe.period, orSession, tz))
inRth = not na(time(timeframe.period, rthSession, tz))
newDay = ta.change(time("D", "0000-2359", tz)) != 0
newRth = inRth and not inRth[1]
is1m = timeframe.isminutes and timeframe.multiplier == 1

var float pmHigh = na
var float pmLow = na
var float orHigh = na
var float orLow = na
var float stop = na
var float target = na
var int side = 0

pmHigh := newDay ? na : inPm ? (na(pmHigh) ? high : math.max(pmHigh, high)) : pmHigh
pmLow := newDay ? na : inPm ? (na(pmLow) ? low : math.min(pmLow, low)) : pmLow
orHigh := newDay ? na : newRth ? high : inOr ? (na(orHigh) ? high : math.max(orHigh, high)) : orHigh
orLow := newDay ? na : newRth ? low : inOr ? (na(orLow) ? low : math.min(orLow, low)) : orLow

vwap5 = request.security(syminfo.tickerid, "5", ta.vwap(hlc3), lookahead=barmerge.lookahead_off)
[plus5, minus5, adx5] = request.security(syminfo.tickerid, "5", ta.dmi(14, 14), lookahead=barmerge.lookahead_off)
atr5 = request.security(syminfo.tickerid, "5", ta.atr(14), lookahead=barmerge.lookahead_off)
rvol5 = request.security(syminfo.tickerid, "5", volume / ta.sma(volume, 20), lookahead=barmerge.lookahead_off)

num(x) => na(x) ? "0" : str.tostring(x)
pair(k, v) => "\"" + k + "\":\"" + v + "\""
numpair(k, v) => "\"" + k + "\":" + num(v)
crossUp(x) => persistence == 1 ? ta.crossover(close, x) : close > x and close[1] > x and close[2] <= x
crossDown(x) => persistence == 1 ? ta.crossunder(close, x) : close < x and close[1] < x and close[2] >= x

code = str.contains(syminfo.ticker, "MES") ? "MES" : "MNQ"
payload(ev, evCode, direction) => "{" + pair("source", "TRADINGVIEW") + "," + pair("action", "ALERT_ONLY") + "," + pair("strategy_context", "INTRADAY_INDEX_FUTURES") + "," + pair("ticker", syminfo.ticker) + "," + pair("timeframe", "1m") + "," + pair("context_timeframe", "5m") + "," + pair("event", ev) + "," + pair("event_code", evCode) + "," + pair("breakout_direction", direction) + "," + numpair("price", close) + "," + numpair("vwap", vwap5) + "," + numpair("adx", adx5) + "," + numpair("atr", atr5) + "," + numpair("volume_relative", rvol5) + "," + numpair("opening_range_high", orHigh) + "," + numpair("opening_range_low", orLow) + "," + numpair("logical_stop", stop) + "," + numpair("logical_target", target) + "," + numpair("signal_bar_open_time_ms", time) + "," + numpair("signal_bar_close_time_ms", time_close) + "," + numpair("alert_emitted_time_ms", timenow) + "," + pair("signal_layer", "FAST_1M_CONFIRMED_WITH_5M_CONTEXT") + ",\"execution_authorized\":false,\"not_order_instruction\":true}"

quality = adx5 >= minAdx and rvol5 >= minRvol
hasOr = not na(orHigh) and not na(orLow)
afterOr = inRth and not inOr
orbL = is1m and barstate.isconfirmed and afterOr and hasOr and crossUp(orHigh) and close > vwap5 and quality
orbS = is1m and barstate.isconfirmed and afterOr and hasOr and crossDown(orLow) and close < vwap5 and quality
vwapL = is1m and barstate.isconfirmed and inRth and not orbL and crossUp(vwap5) and quality
vwapS = is1m and barstate.isconfirmed and inRth and not orbS and crossDown(vwap5) and quality
risk = is1m and barstate.isconfirmed and inRth and ((side == 1 and ta.crossunder(close, vwap5)) or (side == -1 and ta.crossover(close, vwap5)))

side := newDay ? 0 : (orbL or vwapL) ? 1 : (orbS or vwapS) ? -1 : risk ? 0 : side
stop := newDay ? na : (orbL or vwapL) ? close - atr5 : (orbS or vwapS) ? close + atr5 : stop
target := newDay ? na : (orbL or vwapL) ? close + atr5 * 2 : (orbS or vwapS) ? close - atr5 * 2 : target

if orbL
    alert(payload("ORB_BREAKOUT", code + "_ORB_BREAKOUT_LONG_5M", "LONG"), alert.freq_once_per_bar_close)
if orbS
    alert(payload("ORB_BREAKOUT", code + "_ORB_BREAKOUT_SHORT_5M", "SHORT"), alert.freq_once_per_bar_close)
if vwapL
    alert(payload("VWAP_RECLAIM", code + "_VWAP_RECLAIM_LONG_5M", "LONG"), alert.freq_once_per_bar_close)
if vwapS
    alert(payload("VWAP_REJECT", code + "_VWAP_REJECT_SHORT_5M", "SHORT"), alert.freq_once_per_bar_close)
if risk
    alert(payload("RISK_INVALIDATION", code + "_RISK_INVALIDATION_5M", "NONE"), alert.freq_once_per_bar_close)
