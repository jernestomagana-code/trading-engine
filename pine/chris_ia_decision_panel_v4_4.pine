//@version=6
indicator("Chris IA Decision Panel v4.4", shorttitle="CHRIS v4.4", overlay=true, max_labels_count=100)

fastLen = input.int(9, "EMA rapida", minval=2)
slowLen = input.int(21, "EMA lenta", minval=3)
rsiLen = input.int(14, "RSI", minval=2)

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsi = ta.rsi(close, rsiLen)
stoch = ta.stoch(close, high, low, 14)

fDir(tf) =>
    f = request.security(syminfo.tickerid, tf, ta.ema(close, fastLen)[1], lookahead=barmerge.lookahead_off)
    s = request.security(syminfo.tickerid, tf, ta.ema(close, slowLen)[1], lookahead=barmerge.lookahead_off)
    f > s ? 1 : f < s ? -1 : 0

fTxt(d) => d == 1 ? "ALCISTA" : d == -1 ? "BAJISTA" : "NEUTRO"
fBg(d) => d == 1 ? color.new(color.green, 25) : d == -1 ? color.new(color.red, 20) : color.new(color.gray, 55)

dNow = emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
d5 = fDir("5")
d15 = fDir("15")
d60 = fDir("60")

longPrepare = d5 == 1 and rsi > 48 and rsi < 60 and stoch < 65
shortPrepare = d5 == -1 and rsi < 52 and rsi > 40 and stoch > 35
longReady = barstate.isconfirmed and d5 == 1 and d15 == 1 and d60 == 1 and rsi >= 52 and ta.crossover(stoch, 25)
shortReady = barstate.isconfirmed and d5 == -1 and d15 == -1 and d60 == -1 and rsi <= 48 and ta.crossunder(stoch, 75)

side = longReady or longPrepare ? "LONG" : shortReady or shortPrepare ? "SHORT" : "NINGUNO"
action = longReady ? "EVALUAR LONG" : shortReady ? "EVALUAR SHORT" : longPrepare ? "PREPARAR LONG" : shortPrepare ? "PREPARAR SHORT" : "ESPERAR"
missing = d15 == 0 ? "15m SIN DIRECCION" : d60 == 0 ? "60m SIN DIRECCION" : d5 != d15 ? "5m/15m NO ALINEADOS" : d15 != d60 ? "15m/60m NO ALINEADOS" : rsi < 48 or rsi > 60 ? "RSI FUERA DE ZONA" : "GATILLO DE CIERRE"
nextStep = longReady or shortReady ? "REVISAR PRECIO Y RIESGO" : longPrepare or shortPrepare ? "ESPERAR CIERRE CONFIRMADO" : "NO FORZAR ENTRADA"
trigger = side == "LONG" ? high[1] : side == "SHORT" ? low[1] : close
score = (d5 == d15 ? 1 : 0) + (d15 == d60 ? 1 : 0) + (dNow == d5 ? 1 : 0)

var table panel = table.new(position.top_right, 3, 9, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "ACCION AHORA", bgcolor=color.black, text_color=color.white)
    table.cell(panel, 1, 0, action, bgcolor=longReady ? color.lime : shortReady ? color.red : longPrepare or shortPrepare ? color.orange : color.gray, text_color=color.white)
    table.cell(panel, 2, 0, "CALIDAD " + str.tostring(score) + "/3", bgcolor=score == 3 ? color.green : score == 2 ? color.orange : color.red, text_color=color.white)
    table.cell(panel, 0, 1, "GRAFICO " + timeframe.period, text_color=color.silver)
    table.cell(panel, 1, 1, fTxt(dNow), bgcolor=fBg(dNow), text_color=color.white)
    table.cell(panel, 2, 1, "MOVIMIENTO ACTUAL", text_color=color.silver)
    table.cell(panel, 0, 2, "SENAL 5m", text_color=color.silver)
    table.cell(panel, 1, 2, fTxt(d5), bgcolor=fBg(d5), text_color=color.white)
    table.cell(panel, 2, 2, "PREPARA", text_color=color.silver)
    table.cell(panel, 0, 3, "CONFIRMA 15m", text_color=color.silver)
    table.cell(panel, 1, 3, fTxt(d15), bgcolor=fBg(d15), text_color=color.white)
    table.cell(panel, 2, 3, "VALIDA", text_color=color.silver)
    table.cell(panel, 0, 4, "TENDENCIA 60m", text_color=color.silver)
    table.cell(panel, 1, 4, fTxt(d60), bgcolor=fBg(d60), text_color=color.white)
    table.cell(panel, 2, 4, "EVITA CONTRATENDENCIA", text_color=color.silver)
    table.cell(panel, 0, 5, "PROXIMO GATILLO", text_color=color.silver)
    table.cell(panel, 1, 5, side + " " + str.tostring(trigger, format.mintick), text_color=color.yellow)
    table.cell(panel, 2, 5, "NO ENTRAR ANTES", text_color=color.silver)
    table.cell(panel, 0, 6, "FALTA", text_color=color.silver)
    table.cell(panel, 1, 6, missing, text_color=color.orange)
    table.cell(panel, 2, 6, "ESPERAR EVIDENCIA", text_color=color.silver)
    table.cell(panel, 0, 7, "SIGUIENTE PASO", text_color=color.silver)
    table.cell(panel, 1, 7, nextStep, text_color=color.white)
    table.cell(panel, 2, 7, "RIESGO ANTES DE ENTRAR", text_color=color.silver)
    table.cell(panel, 0, 8, "REGLA", text_color=color.silver)
    table.cell(panel, 1, 8, "ALERTA = EVIDENCIA", text_color=color.aqua)
    table.cell(panel, 2, 8, "NO ES ORDEN", text_color=color.aqua)

alertcondition(longPrepare, "Chris v4.4 LONG PREPARE", "CHRIS_V4_4 LONG PREPARE")
alertcondition(shortPrepare, "Chris v4.4 SHORT PREPARE", "CHRIS_V4_4 SHORT PREPARE")
alertcondition(longReady, "Chris v4.4 LONG ENTRY", "CHRIS_V4_4 LONG ENTRY")
alertcondition(shortReady, "Chris v4.4 SHORT ENTRY", "CHRIS_V4_4 SHORT ENTRY")
alertcondition(not longPrepare and longPrepare[1], "Chris v4.4 LONG INVALIDATED", "CHRIS_V4_4 LONG INVALIDATED")
alertcondition(not shortPrepare and shortPrepare[1], "Chris v4.4 SHORT INVALIDATED", "CHRIS_V4_4 SHORT INVALIDATED")
