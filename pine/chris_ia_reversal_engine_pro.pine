//@version=6
indicator("Chris IA Reversal Engine PRO", shorttitle="Chris IA REV PRO", overlay=false, format=format.price, precision=2, max_labels_count=500)

// ==========================================
// Inputs
// ==========================================
grp_calc = "Calculo base"
sourceInput  = input.source(close, "Source", group=grp_calc)
fastLenInput = input.int(9, "MACD fast", minval=1, group=grp_calc)
slowLenInput = input.int(21, "MACD slow", minval=1, group=grp_calc)
sigLenInput  = input.int(5, "MACD signal", minval=1, group=grp_calc)
oscTypeInput = input.string("EMA", "MACD MA type", options=["EMA", "SMA"], group=grp_calc)
sigTypeInput = input.string("EMA", "Signal MA type", options=["EMA", "SMA"], group=grp_calc)
normLenInput = input.int(100, "MACD normalizacion Z", minval=20, group=grp_calc)

grp_sto = "Stochastic / RSI"
stochLenInput = input.int(14, "Stoch length", minval=3, group=grp_sto)
stochSmoothK  = input.int(3, "Smooth K", minval=1, group=grp_sto)
stochSmoothD  = input.int(3, "Smooth D", minval=1, group=grp_sto)
stochOversold = input.float(22.0, "Stoch sobreventa", minval=1, maxval=45, step=0.5, group=grp_sto)
stochOverbought = input.float(78.0, "Stoch sobrecompra", minval=55, maxval=99, step=0.5, group=grp_sto)
rsiLenInput = input.int(14, "RSI length", minval=2, group=grp_sto)
rsiOversold = input.float(38.0, "RSI zona baja", minval=1, maxval=50, step=0.5, group=grp_sto)
rsiOverbought = input.float(62.0, "RSI zona alta", minval=50, maxval=99, step=0.5, group=grp_sto)
rsiRecover = input.float(45.0, "RSI recuperacion LONG", minval=30, maxval=60, step=0.5, group=grp_sto)
rsiReject = input.float(55.0, "RSI perdida SHORT", minval=40, maxval=70, step=0.5, group=grp_sto)

grp_setup = "Motor predictivo"
macdLowZ = input.float(-1.00, "MACD zona baja Z", step=0.10, group=grp_setup)
macdHighZ = input.float(1.00, "MACD zona alta Z", step=0.10, group=grp_setup)
zoneBuffer = input.float(0.35, "Buffer de zona extrema", minval=0, step=0.05, group=grp_setup)
watchScoreInput = input.float(62.0, "Score WATCH minimo", minval=1, maxval=100, step=1, group=grp_setup)
entryScoreInput = input.float(76.0, "Score ENTRY minimo", minval=1, maxval=100, step=1, group=grp_setup)
cooldownBars = input.int(8, "Barras de enfriamiento", minval=0, group=grp_setup)
allowCounterTrend = input.bool(true, "Permitir contra-tendencia con score alto", group=grp_setup)
confirmPriceInput = input.bool(true, "Confirmar con vela/estructura", group=grp_setup)
counterTrendPenalty = input.float(8.0, "Penalizacion contra tendencia", minval=0, maxval=30, step=0.5, group=grp_setup)
counterTrendExtraScore = input.float(10.0, "Extra score si es contra tendencia", minval=0, maxval=30, step=0.5, group=grp_setup)
useCycleGate = input.bool(true, "Una entrada por ciclo extremo", group=grp_setup)
longResetLevel = input.float(45.0, "Rearmar LONG si Stoch sube a", minval=20, maxval=70, step=0.5, group=grp_setup)
shortResetLevel = input.float(55.0, "Rearmar SHORT si Stoch baja a", minval=30, maxval=80, step=0.5, group=grp_setup)

grp_mtf = "Confirmacion MTF"
tfFast = input.timeframe("5", "TF gatillo", group=grp_mtf)
tfConfirm = input.timeframe("15", "TF confirmacion", group=grp_mtf)
tfTrend = input.timeframe("60", "TF tendencia", group=grp_mtf)
minMtfVotes = input.int(1, "Votos MTF minimos", minval=0, maxval=3, group=grp_mtf)
trendFastLen = input.int(34, "EMA tendencia rapida", minval=1, group=grp_mtf)
trendSlowLen = input.int(89, "EMA tendencia lenta", minval=2, group=grp_mtf)

grp_risk = "Filtro de calidad"
useAtrFilter = input.bool(true, "Filtrar mercado muerto por ATR%", group=grp_risk)
atrLenInput = input.int(14, "ATR length", minval=1, group=grp_risk)
minAtrPctInput = input.float(0.05, "ATR% minimo", minval=0, step=0.01, group=grp_risk)
maxAtrPctInput = input.float(8.00, "ATR% maximo", minval=0.1, step=0.1, group=grp_risk)

grp_vis = "Visual"
showSignals = input.bool(true, "Mostrar senales", group=grp_vis)
showRebounds = input.bool(true, "Mostrar rebotes agresivos", group=grp_vis)
showTable = input.bool(true, "Mostrar panel PRO", group=grp_vis)
tablePos = input.string("middle_right", "Posicion panel", options=["top_right", "middle_right", "bottom_right", "top_left", "middle_left", "bottom_left"], group=grp_vis)

grp_alerts = "Alertas"
useDynamicAlerts = input.bool(true, "Alertas dinamicas alert()", group=grp_alerts)
alertEntry = input.bool(true, "Alertar solo ENTRY confirmado", group=grp_alerts)

// ==========================================
// Helpers
// ==========================================
ma(float source, int length, simple string maType) =>
    maType == "EMA" ? ta.ema(source, length) : ta.sma(source, length)

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_pos(string p) =>
    p == "top_right" ? position.top_right :
     p == "middle_right" ? position.middle_right :
     p == "bottom_right" ? position.bottom_right :
     p == "top_left" ? position.top_left :
     p == "middle_left" ? position.middle_left :
     position.bottom_left

f_stoch() =>
    ll = ta.lowest(low, stochLenInput)
    hh = ta.highest(high, stochLenInput)
    den = math.max(hh - ll, syminfo.mintick)
    rawK = 100.0 * (close - ll) / den
    k = ta.sma(rawK, stochSmoothK)
    d = ta.sma(k, stochSmoothD)
    [k, d]

f_core() =>
    fastMA = ma(sourceInput, fastLenInput, oscTypeInput)
    slowMA = ma(sourceInput, slowLenInput, oscTypeInput)
    macd = fastMA - slowMA
    signal = ma(macd, sigLenInput, sigTypeInput)
    hist = macd - signal
    dist = macd - signal
    macdMean = ta.sma(macd, normLenInput)
    macdDev = ta.stdev(macd, normLenInput)
    macdZ = macdDev != 0 ? (macd - macdMean) / macdDev : 0.0
    [k, d] = f_stoch()
    rsi = ta.rsi(sourceInput, rsiLenInput)
    bullCross = ta.crossover(macd, signal)
    bearCross = ta.crossunder(macd, signal)
    stochBull = ta.crossover(k, d)
    stochBear = ta.crossunder(k, d)
    emaFast = ta.ema(close, trendFastLen)
    emaSlow = ta.ema(close, trendSlowLen)
    trendDir = emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
    atrPct = close != 0 ? 100.0 * ta.atr(atrLenInput) / close : 0.0
    [macd, signal, hist, hist[1], dist, dist[1], macdZ, k, d, rsi, bullCross, bearCross, stochBull, stochBear, trendDir, atrPct]

f_dir(float macd, float signal, float hist, int trendDir) =>
    macd > signal and hist > 0 ? 2 :
     macd > signal ? 1 :
     macd < signal and hist < 0 ? -2 :
     macd < signal ? -1 :
     trendDir

// ==========================================
// Current and MTF data
// ==========================================
[macdC, signalC, histC, histPrevC, distC, distPrevC, macdZC, stochKC, stochDC, rsiC, bullC, bearC, stochBullC, stochBearC, trendDirC, atrPctC] = f_core()
[macdF, signalF, histF, histPrevF, distF, distPrevF, macdZF, stochKF, stochDF, rsiF, bullF, bearF, stochBullF, stochBearF, trendDirF, atrPctF] = request.security(syminfo.tickerid, tfFast, f_core(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[macdM, signalM, histM, histPrevM, distM, distPrevM, macdZM, stochKM, stochDM, rsiM, bullM, bearM, stochBullM, stochBearM, trendDirM, atrPctM] = request.security(syminfo.tickerid, tfConfirm, f_core(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[macdT, signalT, histT, histPrevT, distT, distPrevT, macdZT, stochKT, stochDT, rsiT, bullT, bearT, stochBullT, stochBearT, trendDirT, atrPctT] = request.security(syminfo.tickerid, tfTrend, f_core(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

dirC = f_dir(macdC, signalC, histC, trendDirC)
dirF = f_dir(macdF, signalF, histF, trendDirF)
dirM = f_dir(macdM, signalM, histM, trendDirM)
dirT = f_dir(macdT, signalT, histT, trendDirT)

mtfLongVotes = (dirF > 0 ? 1 : 0) + (dirM > 0 ? 1 : 0) + (dirT > 0 ? 1 : 0)
mtfShortVotes = (dirF < 0 ? 1 : 0) + (dirM < 0 ? 1 : 0) + (dirT < 0 ? 1 : 0)

atrPass = not useAtrFilter or (atrPctC >= minAtrPctInput and atrPctC <= maxAtrPctInput)

// ==========================================
// Scoring engine
// ==========================================
macdLowStrict = macdZC <= macdLowZ
macdLowRelaxed = macdZC <= macdLowZ + zoneBuffer
macdHighStrict = macdZC >= macdHighZ
macdHighRelaxed = macdZC >= macdHighZ - zoneBuffer

macdTurningUp = bullC or (histC > histPrevC and distC > distPrevC) or (histC < 0 and histC > histPrevC and histPrevC > nz(histC[2], histPrevC))
macdTurningDown = bearC or (histC < histPrevC and distC < distPrevC) or (histC > 0 and histC < histPrevC and histPrevC < nz(histC[2], histPrevC))

stochLow = stochKC <= stochOversold or stochDC <= stochOversold
stochLowRecent = ta.lowest(stochKC, 3) <= stochOversold or ta.lowest(stochDC, 3) <= stochOversold
stochHigh = stochKC >= stochOverbought or stochDC >= stochOverbought
stochHighRecent = ta.highest(stochKC, 3) >= stochOverbought or ta.highest(stochDC, 3) >= stochOverbought
stochTurningUp = stochBullC or (stochKC > stochDC and stochKC > stochKC[1])
stochTurningDown = stochBearC or (stochKC < stochDC and stochKC < stochKC[1])

rsiLongOK = rsiC <= rsiOversold or ta.crossover(rsiC, rsiRecover) or (rsiC > rsiC[1] and rsiC < 52)
rsiShortOK = rsiC >= rsiOverbought or ta.crossunder(rsiC, rsiReject) or (rsiC < rsiC[1] and rsiC > 48)

trendLongPass = trendDirT >= 0 or allowCounterTrend
trendShortPass = trendDirT <= 0 or allowCounterTrend
mtfLongPass = mtfLongVotes >= minMtfVotes
mtfShortPass = mtfShortVotes >= minMtfVotes
// Un solo voto favorable no convierte una señal en alineada cuando la mayoría
// MTF está en sentido contrario. El radar conserva la señal, pero la clasifica
// como REBOTE en vez de ENTRY confirmada.
counterTrendLong = trendDirT < 0 or mtfLongVotes < minMtfVotes or mtfLongVotes <= mtfShortVotes
counterTrendShort = trendDirT > 0 or mtfShortVotes < minMtfVotes or mtfShortVotes <= mtfLongVotes
entryLongScoreNeeded = entryScoreInput + (counterTrendLong ? counterTrendExtraScore : 0.0)
entryShortScoreNeeded = entryScoreInput + (counterTrendShort ? counterTrendExtraScore : 0.0)
emaTrigger = ta.ema(close, 8)
priceLongConfirm = not confirmPriceInput or close > high[1] or (close > open and close > emaTrigger)
priceShortConfirm = not confirmPriceInput or close < low[1] or (close < open and close < emaTrigger)

scoreLongRaw = 0.0
scoreLongRaw += macdLowStrict ? 22.0 : macdLowRelaxed ? 14.0 : 0.0
scoreLongRaw += macdTurningUp ? 24.0 : 0.0
scoreLongRaw += stochLowRecent ? 14.0 : 0.0
scoreLongRaw += stochTurningUp ? 18.0 : 0.0
scoreLongRaw += rsiLongOK ? 10.0 : 0.0
scoreLongRaw += mtfLongVotes * 4.0
scoreLongRaw += trendDirT >= 0 ? 4.0 : -counterTrendPenalty
scoreLongRaw += atrPass ? 4.0 : -15.0
scoreLong = f_clamp(scoreLongRaw, 0.0, 100.0)

scoreShortRaw = 0.0
scoreShortRaw += macdHighStrict ? 22.0 : macdHighRelaxed ? 14.0 : 0.0
scoreShortRaw += macdTurningDown ? 24.0 : 0.0
scoreShortRaw += stochHighRecent ? 14.0 : 0.0
scoreShortRaw += stochTurningDown ? 18.0 : 0.0
scoreShortRaw += rsiShortOK ? 10.0 : 0.0
scoreShortRaw += mtfShortVotes * 4.0
scoreShortRaw += trendDirT <= 0 ? 4.0 : -counterTrendPenalty
scoreShortRaw += atrPass ? 4.0 : -15.0
scoreShort = f_clamp(scoreShortRaw, 0.0, 100.0)

// WATCH = la compresion extrema ya esta girando. ENTRY = cruce claro con score.
watchLongRaw = scoreLong >= watchScoreInput and macdLowRelaxed and stochLowRecent and macdTurningUp and atrPass and trendLongPass
watchShortRaw = scoreShort >= watchScoreInput and macdHighRelaxed and stochHighRecent and macdTurningDown and atrPass and trendShortPass

var bool longCycleReady = true
var bool shortCycleReady = true
longCycleReset = stochKC >= longResetLevel and macdZC > macdLowZ + zoneBuffer
shortCycleReset = stochKC <= shortResetLevel and macdZC < macdHighZ - zoneBuffer

if longCycleReset
    longCycleReady := true

if shortCycleReset
    shortCycleReady := true

longCyclePass = not useCycleGate or longCycleReady
shortCyclePass = not useCycleGate or shortCycleReady

entryLongRaw = scoreLong >= entryLongScoreNeeded and macdLowRelaxed and stochLowRecent and (bullC or stochBullC) and priceLongConfirm and (mtfLongPass or allowCounterTrend) and atrPass and trendLongPass and longCyclePass
entryShortRaw = scoreShort >= entryShortScoreNeeded and macdHighRelaxed and stochHighRecent and (bearC or stochBearC) and priceShortConfirm and (mtfShortPass or allowCounterTrend) and atrPass and trendShortPass and shortCyclePass

var int lastLongWatchBar = na
var int lastShortWatchBar = na
var int lastLongEntryBar = na
var int lastShortEntryBar = na
longWatchCooldownOK = na(lastLongWatchBar) or bar_index - lastLongWatchBar > cooldownBars
shortWatchCooldownOK = na(lastShortWatchBar) or bar_index - lastShortWatchBar > cooldownBars
longEntryCooldownOK = na(lastLongEntryBar) or bar_index - lastLongEntryBar > cooldownBars
shortEntryCooldownOK = na(lastShortEntryBar) or bar_index - lastShortEntryBar > cooldownBars

longWatch = barstate.isconfirmed and watchLongRaw and longWatchCooldownOK and not entryLongRaw
shortWatch = barstate.isconfirmed and watchShortRaw and shortWatchCooldownOK and not entryShortRaw
longEntry = barstate.isconfirmed and entryLongRaw and longEntryCooldownOK
shortEntry = barstate.isconfirmed and entryShortRaw and shortEntryCooldownOK
longRebound = longEntry and counterTrendLong
shortRebound = shortEntry and counterTrendShort
longConfirmed = longEntry and not counterTrendLong
shortConfirmed = shortEntry and not counterTrendShort

if longWatch
    lastLongWatchBar := bar_index

if shortWatch
    lastShortWatchBar := bar_index

if longEntry
    lastLongEntryBar := bar_index
    longCycleReady := false

if shortEntry
    lastShortEntryBar := bar_index
    shortCycleReady := false

// ==========================================
// Plots
// ==========================================
macdZScaled = f_clamp(50.0 + macdZC * 12.0, 0.0, 100.0)
macdLowScaled = f_clamp(50.0 + macdLowZ * 12.0, 0.0, 100.0)
macdHighScaled = f_clamp(50.0 + macdHighZ * 12.0, 0.0, 100.0)

hline(80, "Sobrecompra", color=color.new(color.red, 65))
hline(50, "Centro", color=color.new(color.gray, 70))
hline(20, "Sobreventa", color=color.new(color.lime, 65))
plot(stochKC, "Stoch K", color=color.new(color.aqua, 0), linewidth=2)
plot(stochDC, "Stoch D", color=color.new(color.orange, 0), linewidth=2)
plot(rsiC, "RSI", color=color.new(color.purple, 0), linewidth=1)
plot(macdZScaled, "MACD Z escalado", color=color.new(color.white, 0), linewidth=2)
plot(macdLowScaled, "MACD zona baja", color=color.new(color.lime, 70), style=plot.style_line)
plot(macdHighScaled, "MACD zona alta", color=color.new(color.red, 70), style=plot.style_line)

plot(scoreLong, "Score LONG", color=color.new(color.lime, 0), linewidth=1, display=display.data_window)
plot(scoreShort, "Score SHORT", color=color.new(color.red, 0), linewidth=1, display=display.data_window)

plotshape(showSignals and longWatch, title="LONG WATCH", text="WATCH L", style=shape.triangleup, location=location.bottom, color=color.new(color.lime, 35), textcolor=color.white, size=size.tiny)
plotshape(showSignals and longConfirmed, title="LONG ENTRY", text="LONG", style=shape.labelup, location=location.bottom, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
plotshape(showSignals and showRebounds and longRebound, title="LONG REBOTE", text="REB L", style=shape.labelup, location=location.bottom, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
plotshape(showSignals and shortWatch, title="SHORT WATCH", text="WATCH S", style=shape.triangledown, location=location.top, color=color.new(color.red, 35), textcolor=color.white, size=size.tiny)
plotshape(showSignals and shortConfirmed, title="SHORT ENTRY", text="SHORT", style=shape.labeldown, location=location.top, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
plotshape(showSignals and showRebounds and shortRebound, title="SHORT REBOTE", text="REB S", style=shape.labeldown, location=location.top, color=color.new(color.maroon, 20), textcolor=color.white, size=size.small)

bgcolor(longEntry ? color.new(color.lime, 88) : shortEntry ? color.new(color.red, 88) : longWatch ? color.new(color.lime, 94) : shortWatch ? color.new(color.red, 94) : na)

// ==========================================
// Panel
// ==========================================
var table proPanel = table.new(f_pos(tablePos), 5, 6, border_width=1, border_color=color.new(color.gray, 60))

f_bias_txt(int d) =>
    d >= 2 ? "ALCISTA+" :
     d == 1 ? "ALCISTA" :
     d <= -2 ? "BAJISTA+" :
     d == -1 ? "BAJISTA" :
     "NEUTRO"

f_bias_bg(int d) =>
    d > 0 ? color.new(color.green, d >= 2 ? 5 : 35) :
     d < 0 ? color.new(color.red, d <= -2 ? 5 : 35) :
     color.new(color.gray, 55)

f_json_num(float value) =>
    str.tostring(na(value) ? 0.0 : value, "#.######")

f_json_bool(bool value) =>
    value ? "true" : "false"

f_symbol_code() =>
    str.upper(str.replace_all(str.replace_all(str.replace_all(syminfo.ticker, ".", ""), "!", ""), ":", ""))

f_event_code(string side, string eventName) =>
    "CHRIS_IA_" + f_symbol_code() + "_" + side + "_" + eventName + "_" + str.upper(timeframe.period)

f_chris_payload(string side, string eventName, float scoreValue, int mtfVotesValue, bool isCounterTrend, bool isRebound, string setupQuality) =>
    "{" +
     "\"action\":\"ALERT_ONLY\"," +
     "\"source\":\"TRADINGVIEW\"," +
     "\"strategy_context\":\"CHRIS_IA_REVERSAL_PRO\"," +
     "\"event\":\"" + eventName + "\"," +
     "\"event_code\":\"" + f_event_code(side, eventName) + "\"," +
     "\"ticker\":\"" + syminfo.ticker + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"price\":" + f_json_num(close) + "," +
     "\"breakout_direction\":\"" + side + "\"," +
     "\"score\":" + f_json_num(scoreValue) + "," +
     "\"score_long\":" + f_json_num(scoreLong) + "," +
     "\"score_short\":" + f_json_num(scoreShort) + "," +
     "\"macd_z\":" + f_json_num(macdZC) + "," +
     "\"stoch_k\":" + f_json_num(stochKC) + "," +
     "\"stoch_d\":" + f_json_num(stochDC) + "," +
     "\"rsi\":" + f_json_num(rsiC) + "," +
     "\"mtf_votes\":" + str.tostring(mtfVotesValue) + "," +
     "\"mtf_long_votes\":" + str.tostring(mtfLongVotes) + "," +
     "\"mtf_short_votes\":" + str.tostring(mtfShortVotes) + "," +
     "\"atr_pct\":" + f_json_num(atrPctC) + "," +
     "\"trend_state\":\"" + f_bias_txt(dirT) + "\"," +
     "\"setup_quality\":\"" + setupQuality + "\"," +
     "\"counter_trend\":" + f_json_bool(isCounterTrend) + "," +
     "\"rebound\":" + f_json_bool(isRebound) +
     "}"

f_row(int row, string label, float macdZ, float k, float rsi, int dir) =>
    table.cell(proPanel, 0, row, label, bgcolor=color.new(color.gray, 55), text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 1, row, str.tostring(macdZ, "#.##"), bgcolor=macdZ <= macdLowZ ? color.new(color.green, 15) : macdZ >= macdHighZ ? color.new(color.red, 15) : color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 2, row, str.tostring(k, "#.0"), bgcolor=k <= stochOversold ? color.new(color.green, 15) : k >= stochOverbought ? color.new(color.red, 15) : color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 3, row, str.tostring(rsi, "#.0"), bgcolor=rsi <= rsiOversold ? color.new(color.green, 20) : rsi >= rsiOverbought ? color.new(color.red, 20) : color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 4, row, f_bias_txt(dir), bgcolor=f_bias_bg(dir), text_color=color.white, text_size=size.tiny)

if showTable
    table.cell(proPanel, 0, 0, "TF", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 1, 0, "MACD-Z", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 2, 0, "STO", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 3, 0, "RSI", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 4, 0, "BIAS", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    f_row(1, "ACTUAL", macdZC, stochKC, rsiC, dirC)
    f_row(2, tfFast, macdZF, stochKF, rsiF, dirF)
    f_row(3, tfConfirm, macdZM, stochKM, rsiM, dirM)
    f_row(4, tfTrend, macdZT, stochKT, rsiT, dirT)
    scoreTxt = "L " + str.tostring(scoreLong, "#") + " / S " + str.tostring(scoreShort, "#") + " | MTF " + str.tostring(mtfLongVotes) + "-" + str.tostring(mtfShortVotes)
    scoreBg = scoreLong >= entryScoreInput ? color.new(color.lime, 0) : scoreShort >= entryScoreInput ? color.new(color.red, 0) : scoreLong >= watchScoreInput ? color.new(color.green, 45) : scoreShort >= watchScoreInput ? color.new(color.red, 45) : color.new(color.gray, 60)
    table.cell(proPanel, 0, 5, "SCORE", bgcolor=color.black, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 1, 5, scoreTxt, bgcolor=scoreBg, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 2, 5, atrPass ? "ATR OK" : "ATR NO", bgcolor=atrPass ? color.new(color.green, 35) : color.new(color.red, 10), text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 3, 5, longConfirmed ? "LONG" : shortConfirmed ? "SHORT" : longRebound ? "REBOTE L" : shortRebound ? "REBOTE S" : longWatch ? "WATCH L" : shortWatch ? "WATCH S" : "ESPERAR", bgcolor=scoreBg, text_color=color.white, text_size=size.tiny)
    table.cell(proPanel, 4, 5, "ATR " + str.tostring(atrPctC, "#.##") + "%", bgcolor=color.new(color.gray, 65), text_color=color.white, text_size=size.tiny)
else
    table.clear(proPanel, 0, 0, 4, 5)

// ==========================================
// Alerts
// ==========================================
alertcondition(longConfirmed, "Chris IA PRO LONG ENTRY", "LONG ENTRY: cruce confirmado con score PRO y confirmacion MTF.")
alertcondition(shortConfirmed, "Chris IA PRO SHORT ENTRY", "SHORT ENTRY: cruce confirmado con score PRO y confirmacion MTF.")

if useDynamicAlerts and barstate.isconfirmed
    if alertEntry and longConfirmed
        alert(f_chris_payload("LONG", "ENTRY", scoreLong, mtfLongVotes, false, false, "CONFIRMED_ENTRY"), alert.freq_once_per_bar_close)
    if alertEntry and shortConfirmed
        alert(f_chris_payload("SHORT", "ENTRY", scoreShort, mtfShortVotes, false, false, "CONFIRMED_ENTRY"), alert.freq_once_per_bar_close)
