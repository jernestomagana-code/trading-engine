{
  "operations_version": "stock_ultimus_portfolio_risk_operations_v1",
  "timezone": "America/New_York",
  "weekday_monitoring_only": true,
  "monitor_window": {
    "start": "07:00",
    "end": "17:30"
  },
  "notification_severities": [
    "CRITICAL",
    "HIGH"
