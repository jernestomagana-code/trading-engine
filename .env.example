# Cloud / Render
DEPLOYMENT_ENV=local
DEPLOYMENT_SCOPE=personal
OPERATING_MODE=ANALYSIS_ONLY
PUBLIC_BASE_URL=https://your-service.onrender.com
WEBHOOK_SECRET=replace-with-a-long-random-secret
# Keep false for direct TradingView alerts until the webhook accepts a
# TradingView-compatible body/query secret instead of a custom HTTP header.
REQUIRE_WEBHOOK_SECRET=false
SNAPSHOT_INGEST_TOKEN=replace-with-a-different-long-random-secret
REQUIRE_SNAPSHOT_INGEST_TOKEN=true

# Optional cloud integrations
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_DEBUG_TOKEN=
READ_ACCESS_TOKEN=
REQUIRE_READ_AUTH=true
RESEND_API_KEY=
RUNTIME_STORAGE_MODE=local_json
DURABLE_STORAGE_PROVIDER=
DURABLE_STORAGE_CONTRACT_VERSION=
DURABLE_STORAGE_ENABLED=false
STOCK_ULTIMUS_TENANT_ID=personal
STOCK_ULTIMUS_ACCOUNT_SCOPE=default
AUDIT_LOG_MAX_EVENTS=10000

# Local IBKR bridge (7497 paper, 7496 live by common TWS defaults)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=10
TRADING_ENGINE_REMOTE_URL=https://your-service.onrender.com
TRADING_ENGINE_INGEST_PATH=/v31_ingest_snapshot
TRADING_ENGINE_INGEST_TOKEN=must-match-SNAPSHOT_INGEST_TOKEN
